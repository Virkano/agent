# Copy to docker/.env and fill in the external service addresses:
# cp docker/.env.example docker/.env
# docker compose --env-file docker/.env up -d --build

# Only one business image is built. Its public HTTP port is always container port 8080.
JB_APP_IMAGE=telecom-ai-agent:local
JB_APP_PORT=8080
JB_DEPLOYMENT_MODE=local

# External PostgreSQL. The database user must be able to create the vector extension
# on a fresh database, or an administrator must create it before first startup.
JB_DB_NAME=initdb
JB_DB_HOST=host.docker.internal
JB_DB_PORT=5432
JB_DB_USER=root
JB_DB_PASSWORD=
JB_DB_MAX_OVERFLOW=80

# External Redis. Leave the password empty only when the existing Redis has no password.
JB_REDIS_HOST=host.docker.internal
JB_REDIS_PORT=6379
JB_REDIS_DB=0
JB_REDIS_PASSWORD=
JB_REDIS_MAX_CONNECTIONS=100

# Ollama stays external. The local vector service is already started inside the image
# on 127.0.0.1:11636 and is intentionally not exposed to the host.
JB_OLLAMA_BASE_URL=http://host.docker.internal:11434
JB_LOCAL_MODEL_HOST_WORKER=1

JB_ADMIN_PATH=/admin
JB_CHAT_PATH=/chat
JB_LOG_LEVEL=INFO
JB_DEFAULT_PASSWORD=TelecomAI@123..
JB_HEALTHCHECK_HOST=localhost

# Required after switching JB_DEPLOYMENT_MODE to production.
JB_SECRET_KEY=
JB_ALLOWED_HOSTS=

# Override only when the deployment network requires an internal Debian mirror.
APT_DEBIAN_MIRROR=https://deb.debian.org/debian
APT_SECURITY_MIRROR=https://deb.debian.org/debian-security
